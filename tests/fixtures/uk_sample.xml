<?xml version="1.0" encoding="UTF-8"?>
<Legislation xmlns="http://www.legislation.gov.uk/namespaces/legislation" xmlns:ukm="http://www.legislation.gov.uk/namespaces/metadata">
  <Metadata><ukm:Year Value="2018"/></Metadata>
  <EURetained>
    <EUPrelims>
      <EUPreamble>
        <P><Text>THE EUROPEAN PARLIAMENT AND THE COUNCIL OF THE EUROPEAN UNION,</Text></P>
        <Division id="division-1"><Number>(1)</Number><P><Text>The protection of natural persons is a fundamental right.</Text></P></Division>
        <Division id="division-2"><Number>(2)</Number><P><Text>The principles   should respect<FootnoteRef Ref="f00001"/> rights<CommentaryRef Ref="key-1"/>.</Text></P></Division>
        <Division id="division-3"><Number>(3)</Number><Title>The first sentence sits in a title element.</Title><P><Text>The second sentence is in the paragraph.</Text></P></Division>
      </EUPreamble>
    </EUPrelims>
    <EUBody>
      <EUChapter>
        <Number>CHAPTER I</Number>
        <Title>General provisions</Title>
        <P1group>
          <Title>Subject-matter</Title>
          <P1 DocumentURI="x" IdURI="y" id="article-1">
            <Pnumber>Article 1</Pnumber>
            <P1para>
              <P2 id="article-1-1">
                <Pnumber PuncBefore="" PuncAfter=".">1</Pnumber>
                <P2para>
                  <Text>This Regulation lays down rules relating to:</Text>
                  <P3 id="article-1-1-a"><Pnumber PuncBefore="(" PuncAfter=")">a</Pnumber><P3para><Text>the protection of natural persons; and</Text></P3para></P3>
                  <P3 id="article-1-1-b"><Pnumber PuncBefore="(" PuncAfter=")">b</Pnumber><P3para><Text>the free movement of such data.</Text></P3para></P3>
                  <Text>The first subparagraph is without prejudice to national law.</Text>
                </P2para>
              </P2>
              <P2 id="article-1-2">
                <Pnumber PuncBefore="" PuncAfter=".">2</Pnumber>
                <P2para><Text>This Regulation protects <Addition ChangeId="a1" CommentaryRef="c1">fundamental</Addition> rights<CommentaryRef Ref="c1"/>.</Text></P2para>
              </P2>
              <P2 id="article-1-5"><Pnumber PuncAfter=".">5</Pnumber><P2para><Text>Words before a list:</Text><P3 id="article-1-5-a"><Pnumber PuncBefore="(" PuncAfter=")">a</Pnumber><P3para><Text>a kept point;</Text></P3para></P3><Text>. . . .</Text></P2para></P2>
              <P2 id="article-1-4"><Pnumber PuncAfter=".">4</Pnumber><P2para><Text>. . . . . . . . . . . . . . . .</Text></P2para></P2>
              <P2 id="article-1-3" Status="Prospective">
                <Pnumber PuncBefore="" PuncAfter=".">3</Pnumber>
                <P2para><Text>A paragraph that is not yet in force.</Text></P2para>
              </P2>
            </P1para>
          </P1>
        </P1group>
        <P1group><Title>Omitted heading</Title><P1 id="article-3"><Pnumber>Article 3</Pnumber><P1para><Text>. . . . . . . . . . . . . . . .</Text></P1para></P1></P1group>
        <P1group><Title>Omitted inside</Title><P1 id="article-4"><Pnumber>Article 4</Pnumber><P1para><P2 id="article-4-1"><Pnumber PuncAfter=".">1</Pnumber><P2para><Text>. . . . . . . .</Text></P2para></P2></P1para></P1></P1group>
        <P1group RestrictStartDate="2026-02-05">
          <Title>Recognised legitimate interests</Title>
          <P1 id="article-1A" RestrictStartDate="2026-02-05">
            <Pnumber>Article 1A</Pnumber>
            <P1para><Text><Substitution ChangeId="s1" CommentaryRef="c2">An inserted article.</Substitution></Text></P1para>
          </P1>
        </P1group>
        <P1group Status="Repealed" Match="true">
          <Title>Repealed title</Title>
          <P1 id="article-2" Status="Repealed"><Pnumber>Article 2</Pnumber><P1para><Text>Repealed text.</Text></P1para></P1>
        </P1group>
      </EUChapter>
    </EUBody>
    <Schedule id="annex-1" RestrictStartDate="2026-02-05">
      <Number>ANNEX 1</Number>
      <TitleBlock><Title>LAWFULNESS OF PROCESSING</Title></TitleBlock>
      <ScheduleBody>
        <P1group RestrictStartDate="2026-02-05">
          <Title>Disclosure for purposes</Title>
          <P1 id="annex-1-1"><Pnumber>1</Pnumber><P1para><Text>This condition is met where the disclosure is necessary.</Text></P1para></P1>
        </P1group>
      </ScheduleBody>
    </Schedule>
  </EURetained>
  <Primary>
    <Body>
      <Part>
        <Number>PART 2</Number>
        <Title>General processing</Title>
        <Chapter>
          <Number>CHAPTER 1</Number>
          <Title>Scope</Title>
          <Pblock>
            <Title>Lawfulness</Title>
            <P1group>
              <Title>Lawfulness of processing</Title>
              <P1 id="section-6"><Pnumber>6</Pnumber><P1para><Text>Processing is lawful if a basis applies.</Text></P1para></P1>
            </P1group>
            <P1group>
              <Title>Index of expressions</Title>
              <P1 id="section-8">
                <Pnumber>8</Pnumber>
                <P1para><Text>The Table below lists provisions.</Text></P1para>
                <Tabular>
                  <table><colgroup><col/><col/></colgroup><tbody>
                    <tr><td>the affirmative procedure</td><td>section 182</td></tr>
                    <tr><td>the negative procedure</td><td>section 183</td></tr>
                  </tbody></table>
                </Tabular>
              </P1>
            </P1group>
            <P1group>
              <Title>Powers</Title>
              <P1 id="section-7">
                <Pnumber>7</Pnumber>
                <P1para>
                  <P2 id="section-7-1">
                    <Pnumber PuncAfter=".">1</Pnumber>
                    <P2para>
                      <Text>The Secretary of State may by regulations</Text>
                      <BlockAmendment Context="main" Format="double" TargetClass="primary">
                        <P2><Pnumber>8</Pnumber><P2para><Text>An order may in particular—</Text><P3><Pnumber>a</Pnumber><P3para><Text>specify a document;</Text></P3para></P3></P2para></P2>
                      </BlockAmendment>
                    </P2para>
                  </P2>
                </P1para>
              </P1>
            </P1group>
          </Pblock>
        </Chapter>
      </Part>
      <Schedule id="schedule-1">
        <Number>Schedule 1</Number>
        <TitleBlock><Title>Special categories conditions</Title></TitleBlock>
        <ScheduleBody>
          <P><Text>This Schedule sets out conditions.</Text></P>
          <Part>
            <Number>Part 1</Number>
            <Title>Employment</Title>
            <P1group>
              <Title>Employment, social security</Title>
              <P1 id="schedule-1-paragraph-1">
                <Pnumber>1</Pnumber>
                <P1para>
                  <P2 id="schedule-1-paragraph-1-1">
                    <Pnumber PuncAfter=".">1</Pnumber>
                    <P2para><Text>This condition is met if the processing is necessary:</Text>
                      <P3 id="schedule-1-paragraph-1-1-a"><Pnumber>a</Pnumber><P3para><Text>for the purposes of employment law;</Text></P3para></P3>
                    </P2para>
                  </P2>
                </P1para>
              </P1>
            </P1group>
          </Part>
        </ScheduleBody>
      </Schedule>
    </Body>
