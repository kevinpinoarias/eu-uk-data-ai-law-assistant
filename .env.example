# Copy this file to .env and fill it in. .env is git-ignored; never commit real keys.

# Model provider key (provider not yet decided; Gemini is the current candidate)
GEMINI_API_KEY=

# Contact shown in the User-Agent of every fetcher, so source sites can reach us
# (legislation.gov.uk requires an identifying User-Agent). Example: you@example.com
FETCHER_CONTACT=
